#
# Arcadyan AW1000 on the NSS-EDMA tree.
#
# Appended to builder-reference/devices/common/config (the NSS stack, toolchain
# and hardening options shared with Julius's builder); this file wins on any
# symbol set in both.
#

## Device: single profile, 1 GB memory class. The subtarget is ours to set:
## the builder's common config leaves it to each device group.
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_arcadyan_aw1000=y
CONFIG_ATH11K_MEM_PROFILE_1G=y
CONFIG_NSS_MEM_PROFILE_HIGH=y

## Cellular WAN offload: qca-nss-drv binds raw-IP modem netdevs to rmnet_rx
## (default y on ipq807x since nss-packages 944ea25; kept explicit).
CONFIG_NSS_DRV_RMNET_ENABLE=y
CONFIG_NSS_DRV_C2C_ENABLE=y
# initramfs FIT for USB boot testing (U-Boot: usbboot 0x44000000 0:4)
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y

## Modem data path: qmi_wwan_q with two QMAP channels + quectel-cm proto.
## uqmi comes with the AW1000's DEVICE_PACKAGES and pulls upstream qmi_wwan,
## which matches the same Quectel IDs as qmi_wwan_q; keep it out.
# CONFIG_PACKAGE_uqmi is not set
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan is not set
CONFIG_PACKAGE_kmod-qmi_wwan_q=y
CONFIG_QMI_WWAN_Q_QMAP_MODE=2
CONFIG_PACKAGE_quectel-cm=y
CONFIG_PACKAGE_luci-proto-quectel=y
CONFIG_PACKAGE_sms-tool=y

## Modem pages (4IceG): signal and cell details, band lock, SMS/USSD and AT
## consoles, all over the modem's AT port with sms-tool.
CONFIG_PACKAGE_luci-app-modemdata=y
CONFIG_PACKAGE_luci-app-modemband=y
CONFIG_PACKAGE_luci-app-sms-tool-js=y
CONFIG_PACKAGE_luci-app-atinout=y

## Board defaults: LAN 192.168.254.1, wwan interface, LEDs, theme
CONFIG_PACKAGE_aw1000-defaults=y

## LuCI theme and the Status → Dashboard page
CONFIG_PACKAGE_luci-theme-footstrap=y
CONFIG_PACKAGE_luci-mod-dashboard=y

## Tools and services
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_luci-app-wol=y
# luci-app-wol does not pull the tool it runs
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_udp-broadcast-relay-redux=y

## USB storage: mass storage + UAS, common filesystems, automount under
## /mnt/<device> (fstab anon_mount, set in aw1000-defaults), browsable from
## LuCI with the Footstrap file manager.
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_luci-app-footstrap-files=y
