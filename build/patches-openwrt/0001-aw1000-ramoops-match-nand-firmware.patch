 #include <dt-bindings/input/input.h>
 #include <dt-bindings/leds/common.h>
 
+/*
+ * Same layout as the NAND firmware (OpenWrt 6.6) uses at this address, so
+ * after a USB test boot falls back to NAND the oops/console records of the
+ * test kernel are still readable there (and vice versa).
+ */
+&ramoops_region {
+	record-size = <0x4000>;
+	console-size = <0x4000>;
+};
