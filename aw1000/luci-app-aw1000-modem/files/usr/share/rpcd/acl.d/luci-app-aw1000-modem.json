{
	"luci-app-aw1000-modem": {
		"description": "Grant access to the AW1000 modem pages: SMS, bands, cell lock, AT commands, the RJ11 phone",
		"read": {
			"file": {
				"/tmp/aw1000-status/*": [ "read" ]
			},
			"uci": [ "awvoice" ],
			"ubus": {
				"file": [ "read" ],
				"luci.aw1000-modem": [ "job_status" ],
				"awvoice": [ "status", "health", "calls", "call_status", "recording_get", "message_get" ]
			}
		},
		"write": {
			"uci": [ "awvoice" ],
			"ubus": {
				"luci.aw1000-modem": [ "at", "job_start", "sms_list", "sms_send", "sms_delete", "sms_storage", "lock", "phone" ],
				"awvoice": [ "calls_delete", "hangup", "reload", "web_originate", "web_answer", "web_reject", "web_hangup", "web_dtmf", "web_flash", "web_audio_open" ],
				"uci": [ "commit" ]
			}
		}
	}
}
