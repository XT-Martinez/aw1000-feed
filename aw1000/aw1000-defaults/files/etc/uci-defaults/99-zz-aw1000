#!/bin/sh
# Runs once, after the board defaults and before the builder's
# 999-QOL_config, which derives DHCP option 42 from the LAN address set here.
#
# The file ships in the image, so it runs again after every settings-keeping
# sysupgrade; the marker keeps it from resetting what was changed since.
[ "$(uci -q get system.@system[0].aw1000_defaults)" = 1 ] && exit 0

. /lib/functions.sh

# LAN
uci -q set network.lan.ipaddr='192.168.254.1'

# Modem data path: quectel-cm through netifd, IPv4 on wwan0_1 by default. For
# IPv6 on its own PDN set pdptype ipv4v6, multiplexing 1 and apnv6: the IPv6
# call then rides wwan0_2 (qmi_wwan_q built with qmap_mode=2) and comes up as
# the dynamic interface wwan_6 in the same zone.
if ! uci -q get network.wwan >/dev/null; then
	uci set network.wwan='interface'
	uci set network.wwan.proto='quectel'
	uci set network.wwan.device='/dev/cdc-wdm0'
	uci set network.wwan.apn='internet'
	uci set network.wwan.pdptype='ipv4'
	uci set network.wwan.multiplexing='0'
	uci set network.wwan.auth='none'
	uci set network.wwan.metric='10'
fi

wan_zone="$(uci show firewall | sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name='wan'$/\1/p" | head -n1)"
if [ -n "$wan_zone" ]; then
	uci -q del_list "firewall.$wan_zone.network=wwan"
	uci add_list "firewall.$wan_zone.network=wwan"
fi

# LEDs: signal, 5G, internet and phone belong to aw1000-leds, Wi-Fi to a
# trigger.
drop_led() {
	local sysfs

	config_get sysfs "$1" sysfs
	case "$sysfs" in
	*:5g | *:signal | green:internet | green:wifi | green:phone)
		uci -q delete "system.$1"
		;;
	esac
}
config_load system
config_foreach drop_led led

uci set system.led_wifi='led'
uci set system.led_wifi.name='Wi-Fi'
uci set system.led_wifi.sysfs='green:wifi'
# Steady while the 5 GHz AP is up: ath11k registers no phyNtpt throughput
# trigger (only rx/tx/assoc/radio), so use the netdev trigger's link state.
uci set system.led_wifi.trigger='netdev'
uci set system.led_wifi.dev='phy0-ap0'
uci set system.led_wifi.mode='link'

# USB drives: mount anything plugged in under /mnt/<device>, no fstab entry
# needed.
uci -q get fstab.@global[0] >/dev/null || uci add fstab global >/dev/null
uci set fstab.@global[0].anon_mount='1'
uci set fstab.@global[0].auto_mount='1'

# Theme
[ -d /www/luci-static/footstrap ] && uci -q set luci.main.mediaurlbase='/luci-static/footstrap'

uci set system.@system[0].aw1000_defaults='1'

uci commit network
uci commit firewall
uci commit system
uci commit fstab
uci commit luci

exit 0
