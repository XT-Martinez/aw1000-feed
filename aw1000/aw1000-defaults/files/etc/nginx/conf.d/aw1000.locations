# Arcadyan AW1000 (aw1000-defaults): nginx on 80/443 in front of uhttpd.
#
# LuCI stays on uhttpd, which listens on 127.0.0.1:8080 only (plain HTTP on
# loopback); nginx holds the LAN ports, terminates TLS with uhttpd's own
# certificate and passes every request through. What nginx adds is the Phone
# page's call audio on the same address and port as the page itself, so the
# browser needs no second port and no second certificate exception.
# /etc/uci-defaults/96-aw1000-web sets this up.

# The Phone page asks for this to learn that the audio is on this origin.
location = /awvoice/ping {
	access_log off;
	return 204;
}

# The Phone page's browser audio: awvoice-phoned's WebSocket listener, on
# loopback (awvoice.main.web_iface 'loopback', web_port 7443) and TLS on its
# own side too.
location = /awvoice/audio {
	proxy_pass https://127.0.0.1:7443/audio;
	proxy_ssl_verify off;
	proxy_http_version 1.1;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection "upgrade";
	proxy_set_header Host $host;
	proxy_buffering off;
	proxy_read_timeout 1h;
	proxy_send_timeout 1h;
	tcp_nodelay on;
}

# Everything else: LuCI and the rest of /www on uhttpd. Unbuffered both ways,
# so a firmware upload streams through and long requests answer as they go.
location / {
	proxy_pass http://127.0.0.1:8080;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header Connection "";
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_buffering off;
	proxy_request_buffering off;
	proxy_read_timeout 10m;
	proxy_send_timeout 10m;
	client_max_body_size 256m;
}
